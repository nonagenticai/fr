# FR Frontend Environment Variables
# Copy this file to .env for local development.
# For Docker builds these are passed as build args (see frontend/Dockerfile).

# Backend proxy target — SvelteKit server-side routes under /api/ forward here.
# The browser never talks to the backend directly (same-origin only).
FR_BACKEND_URL=http://localhost:8888

# Keycloak
VITE_KEYCLOAK_URL=https://keycloak.example.com
VITE_KEYCLOAK_REALM=example
VITE_KEYCLOAK_CLIENT_ID=fr-frontend

# Optional integrations. Empty = the feature is not configured.
VITE_KAG_URL=
VITE_CODE_GRAPH_URL=
VITE_ORCHESTRATOR_URL=
VITE_LICENSES_URL=

# Optional: direct secrets-service access (if needed).
# VITE_SECRETS_URL=

# Optional: DEV-only auth bypass for Playwright captures.
# When set to 'true' and running in `vite dev` (import.meta.env.DEV), the
# frontend skips Keycloak and synthesises a super-admin dev user. The backend
# must run with AUTH_BYPASS=true in parallel. Dead-code-eliminated from
# production builds.
# VITE_AUTH_BYPASS=true
