{
	"name": "frontend",
	"license": "Apache-2.0",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"bundle:icons": "bun scripts/bundle-n8n-icons.ts",
		"bundle:schemas": "bun scripts/bundle-n8n-schemas.ts",
		"bundle:n8n": "bun scripts/bundle-n8n-icons.ts && bun scripts/bundle-n8n-schemas.ts",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e:dev-cluster": "FR_E2E_LIVE=1 playwright test --project=dev-cluster",
		"sweep:live": "FR_SWEEP_LIVE=1 FR_SWEEP_MODE=live playwright test --project=sweep-live",
		"ci:verify": "npm run check"
	},
	"devDependencies": {
		"@playwright/test": "^1.65.0",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^26.6.6",
		"@vitest/ui": "^5.1.0",
		"jsdom": "^30.1.2",
		"patch-package": "^8.0.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"typescript": "^6.0.3",
		"vite": "^8.3.7",
		"vitest": "^5.0.4"
	},
	"dependencies": {
		"@dagrejs/dagre": "^3.1.3",
		"@sveltejs/adapter-node": "^6.0.2",
		"@tanstack/svelte-virtual": "^3.13.52",
		"@types/d3": "^7.4.3",
		"@xyflow/svelte": "^1.7.1",
		"ajv": "^8.20.0",
		"autoprefixer": "^10.6.2",
		"cronstrue": "^3.39.0",
		"d3": "^7.9.2",
		"dompurify": "^3.4.17",
		"http-proxy-3": "^2.0.2",
		"jsonpath-plus": "11.3.0",
		"keycloak-js": "^26.2.5",
		"lucide-svelte": "^1.0.1",
		"postcss": "^8.5.32",
		"svelte-dnd-action": "^0.9.80",
		"tailwindcss": "^4.3.5"
	},
	"overrides": {
		"cookie": "^0.7.2",
		"devalue": "^5.8.0",
		"picomatch": "^4.0.7",
		"rollup": "^4.64.5"
	}
}
