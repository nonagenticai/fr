# ============================================================================
# fr/backend — environment example
# ============================================================================
# Copy to .env and fill in the values. Never commit a real .env.

# Core
DATABASE_URL=postgres://postgres:postgres@localhost:5432/fr
REDIS_URL=redis://localhost:6379
PORT=8888
NODE_ENV=development

# Keycloak (OIDC)
KEYCLOAK_URL=https://keycloak.example.com
KEYCLOAK_REALM=example
KEYCLOAK_CLIENT_ID=fr-backend
KEYCLOAK_CLIENT_SECRET=CHANGE_ME
KEYCLOAK_ISSUER=https://keycloak.example.com/realms/example

# Optional second realm for metering writes. Leave unset to reuse the portal realm.
# KEYCLOAK_SECURE_APPS_URL=
# KEYCLOAK_SECURE_APPS_REALM=
# KEYCLOAK_SECURE_APPS_CLIENT_ID=
# KEYCLOAK_SECURE_APPS_CLIENT_SECRET=

# Security keys (generate 64 hex characters)
SECRET_ENCRYPTION_KEY=CHANGE_ME_GENERATE_64_CHAR_HEX
JWT_SECRET_KEY=CHANGE_ME_GENERATE_64_CHAR_HEX

# ---------------------------------------------------------------------------
# Integrations — in development an empty URL disables the integration.
# In production FR refuses to boot until the configured set is present.
# ---------------------------------------------------------------------------
N8N_API_URL=
N8N_WEBHOOK_URL=
PLANKA_BASE_URL=
PLANKA_AGENT_EMAIL=agent@example.com
PLANKA_AGENT_PASSWORD=
KANBAN_API_URL=
WORKERS_API_URL=
REQUIREMENTS_API_URL=
KAG_API_URL=
CODING_GATEWAY_URL=
SECRETS_API_URL=
ARTIFACTS_API_URL=
BILLING_BASE_URL=
LICENSES_URL=
PROMETHEUS_URL=
PUSHGATEWAY_URL=
GRAFANA_URL=
PROVISIONING_BASE_URL=

# Microsoft Teams notification channel
TEAMS_ENABLED=false
TEAMS_WEBHOOK_URL=
TEAMS_CALLBACK_URL=
TEAMS_WEBHOOK_SECRET=

# fr -> n8n approval callback. The receiver must present the same secret.
APPROVAL_CALLBACK_SECRET=CHANGE_ME

# Conveyor start webhook (fr -> n8n). Empty URL = inert.
CONVEYOR_START_WEBHOOK_URL=
CONVEYOR_START_WEBHOOK_SECRET=
CONVEYOR_START_WEBHOOK_TIMEOUT_MS=
CONVEYOR_START_STALLED_RETRY=false

# Allowed origins for n8n Wait-node resume URLs (comma-separated).
# Empty = every callback_url is refused.
N8N_CALLBACK_ORIGINS=
