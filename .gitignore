# Environment files
.env
.env.*
!.env.example

# Certificates and private keys (fr#1266). `certs/` already matches a certs/
# dir at any depth, but ten key/cert files were force-added past it anyway, so
# ignore rules are a convenience, not the gate: the load-bearing keep-out is
# the tree scan backend/scripts/check-no-private-keys.sh (run by `ci:verify`).
certs/
**/certs/
*.key
*-key.pem
*_key.pem
*.key.pem
privkey*.pem
*.p12
*.pfx

# Backup files - prevent future backup files from being tracked
*.bak
*.bak1
*.bak2
*.bak3
*.bak4
*.backup
*.old
*.orig
*.save

# Docker compose backups
docker-compose*.bak*
docker-compose*.backup
docker-compose*.old

# Environment file backups
.env.bak*
.env.backup
.env.old
.env.orig

# Source code backups
*.py.bak*
*.py.backup
*.ts.bak*
*.ts.backup
*.js.bak*
*.js.backup
certs/ca-cert.pem
.env

# Git worktrees
.worktrees/
.claude/

# CI failure-report artifacts (generated by gitops-production/scripts/check-failures.sh)
01_recent_push_failure.txt
02_deploy_issues.txt

# macOS metadata
.DS_Store
._*

# Machine-generated orval config (absolute worktree paths) — regenerated by clients:generate
tooling/openapi/orval.generated.ts

# SvelteKit sync run from the repo root (rather than frontend/) drops a stray
# build tree here. frontend/.gitignore only covers frontend/.svelte-kit.
/.svelte-kit
