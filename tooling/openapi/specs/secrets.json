          "updated_at": {
            "type": "string",
            "title": "Updated At"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "secret_client_id",
          "user_id",
          "identifier",
          "url",
          "auth_info",
          "metadata",
          "created_at",
          "updated_at",
          "expires_at"
