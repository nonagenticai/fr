{
  "openapi": "3.1.0",
  "info": {
    "title": "secrets-service",
    "description": "Tenant-isolated encrypted storage for secrets, BYOC client configs, and URL credentials. Fernet encryption at rest, license-token auth, BOLA protection, upsert-by-identifier, and TTL expiration.",
    "version": "1.0.0"
  },
