  "components": {
    "schemas": {
      "BYOCConfigData": {
        "properties": {
          "identifier": {
            "type": "string",
            "title": "Identifier",
            "description": "User-friendly identifier (unique per user)"
          },
          "url": {
            "type": "string",
            "title": "Url",
            "description": "Client URL or endpoint"
          },
          "auth_info": {
            "additionalProperties": true,
            "type": "object",
            "title": "Auth Info",
            "description": "Authentication information (credentials, tokens, etc.)"
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata",
            "description": "Additional metadata"
          },
          "ttl": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ttl",
            "description": "Time-to-live in seconds (optional)"
          }
        },
        "type": "object",
        "required": [
          "identifier",
          "url",
          "auth_info"
        ],
        "title": "BYOCConfigData",
        "description": "Data for storing BYOC client configuration"
      },
      "BYOCConfigListItem": {
        "properties": {
          "secret_client_id": {
            "type": "string",
            "title": "Secret Client Id"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "identifier": {
            "type": "string",
            "title": "Identifier"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "title": "Updated At"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "metadata": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Metadata"
          }
        },
        "type": "object",
        "required": [
          "secret_client_id",
          "user_id",
          "identifier",
          "created_at",
          "updated_at",
          "expires_at",
          "metadata"
        ],
        "title": "BYOCConfigListItem",
        "description": "Single item in BYOC configuration list"
      },
      "BYOCConfigListResponse": {
        "properties": {
          "configs": {
            "items": {
              "$ref": "#/components/schemas/BYOCConfigListItem"
            },
            "type": "array",
            "title": "Configs"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "configs",
          "total"
        ],
        "title": "BYOCConfigListResponse",
        "description": "Response when listing BYOC configurations for a user"
      },
      "BYOCConfigResponse": {
        "properties": {
          "secret_client_id": {
            "type": "string",
            "title": "Secret Client Id",
            "description": "Unique identifier for this configuration"
          },
          "user_id": {
            "type": "string",
            "title": "User Id",
            "description": "User/entity that owns this configuration"
          },
          "identifier": {
            "type": "string",
            "title": "Identifier",
            "description": "User-friendly identifier"
          },
          "created_at": {
            "type": "string",
            "title": "Created At",
            "description": "ISO 8601 creation timestamp"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At",
            "description": "ISO 8601 expiration timestamp"
          }
        },
        "type": "object",
        "required": [
          "secret_client_id",
          "user_id",
          "identifier",
          "created_at"
        ],
        "title": "BYOCConfigResponse",
        "description": "Response when storing a BYOC configuration"
      },
      "BYOCConfigRetrieveResponse": {
        "properties": {
          "secret_client_id": {
            "type": "string",
            "title": "Secret Client Id"
          },
